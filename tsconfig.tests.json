{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
