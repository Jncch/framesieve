{
  "name": "@framesieve/adapters",
  "version": "0.3.0",
  "description": "Capture sources (electron, browser, node) plus recorder and replay for framesieve.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jncch/framesieve.git",
    "directory": "packages/adapters"
  },
  "sideEffects": false,
  "types": "./dist/node/index.d.ts",
  "exports": {
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/cjs/node/index.d.ts",
        "default": "./dist/cjs/node/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "require": {
        "types": "./dist/cjs/browser/index.d.ts",
        "default": "./dist/cjs/browser/index.js"
      }
    },
    "./electron": {
      "import": {
        "types": "./dist/electron/index.d.ts",
        "default": "./dist/electron/index.js"
      },
      "require": {
        "types": "./dist/cjs/electron/index.d.ts",
        "default": "./dist/cjs/electron/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "framesieve": "^0.4.0"
  }
}
