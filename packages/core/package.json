{
  "name": "framesieve",
  "version": "0.1.0",
  "description": "Deterministic frame gating for vision AI. Decides which captured frames are worth sending to a VLM.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jncch/framesieve.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
